{
  "name": "@wapp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/database/migrate-cli.ts",
    "db:import-sqlite": "node --env-file-if-exists=../../.env --import tsx src/database/import-sqlite.ts",
    "user:create": "node --env-file-if-exists=../../.env --import tsx src/modules/auth/create-user.ts"
  },
  "dependencies": {
    "@wapp/contracts": "*",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "marked": "^18.1.1",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "whatsapp-web.js": "1.34.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8"
  }
}
