# Local: node scripts/setup.mjs gera valores aleatórios.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
POSTGRES_DB=wapp
POSTGRES_USER=wapp
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
TEST_DATABASE_URL=
JWT_SECRET=
JWT_TTL_SECONDS=28800
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
DATA_DIR=data
WEB_PORT=3000
SCHEDULER_INTERVAL_MS=5000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false
CHROME_NO_SANDBOX=false
# Opcional, para usar navegador já instalado:
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# Opcional: pasta dos binários pg_ctl/initdb para o banco privado local.
# LOCAL_POSTGRES_BIN=/usr/lib/postgresql/16/bin
