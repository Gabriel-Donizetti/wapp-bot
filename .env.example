# node scripts/setup.mjs gera valores aleatórios para uma instalação nova.
# Referência completa e diferenças Docker/local: docs/docker.md
# No Compose, só entram no container os valores referenciados em compose.yaml.

# API local. O Compose fixa HOST=0.0.0.0, PORT=3000 e NODE_ENV=production.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# PostgreSQL do Compose. POSTGRES_PORT altera somente a porta no host.
POSTGRES_DB=wapp
POSTGRES_USER=wapp
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# URLs locais; em Docker, a API recebe uma URL montada com POSTGRES_* e host db.
DATABASE_URL=
TEST_DATABASE_URL=

# JWT: segredo com pelo menos 32 caracteres; validade entre 60 e 86400 segundos.
JWT_SECRET=
JWT_TTL_SECONDS=28800
# Bootstrap: usado somente quando não há usuários; senha de 12 a 128 caracteres.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Em Docker, DATA_DIR é fixado em /app/data, coberto pelo volume de perfis.
DATA_DIR=data
# Porta pública do Nginx no host, vinculada a 127.0.0.1.
WEB_PORT=3000
# Job de agendamentos local. O Compose usa o padrão 5000 sem repassar esta chave.
# Não altera o monitor de entrega, cujo intervalo é de cinco minutos.
SCHEDULER_INTERVAL_MS=5000
# Origens de frontends externos, separadas por vírgula. Não inclua caminho da API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Em Docker, TRUST_PROXY e CHROME_NO_SANDBOX são fixados em true.
TRUST_PROXY=false
CHROME_NO_SANDBOX=false
# Opcional, para usar navegador já instalado:
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# Opcional: pasta dos binários pg_ctl/initdb para o banco privado local.
# LOCAL_POSTGRES_BIN=/usr/lib/postgresql/16/bin
